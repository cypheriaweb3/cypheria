@@ -77,4 +77,14 @@ if (os.platform() !== 'win32') {
   }
 }
 
+// The published prebuilt spawn-helper is not executable, which makes every spawn fail with
+// "posix_spawnp failed" on macOS. Restore the executable bit for the prebuilds that ship it.
+const PREBUILDS_DIR = path.join(__dirname, '../prebuilds');
+if (os.platform() !== 'win32' && fs.existsSync(PREBUILDS_DIR)) {
+  for (const target of fs.readdirSync(PREBUILDS_DIR)) {
+    const helper = path.join(PREBUILDS_DIR, target, 'spawn-helper');
+    if (fs.existsSync(helper)) fs.chmodSync(helper, 0o755);
+  }
+}
+
 process.exit(0);
