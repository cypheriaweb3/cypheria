{
  "name": "browser",
  "version": "0.6.0",
  "hooks": {
    "hooks": {
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "node_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${session_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "node_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${agent_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "node_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${session_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ]
    }
  },
  "description": "Browser / browser-use plugin\n\nUse Browser, the Cypheria in-app browser, when the user asks to open, inspect, navigate, test, click, type, or screenshot web targets such as localhost, 127.0.0.1, dApps, or in-app browser tabs.\n\nCypheria connects directly to the built-in desktop browser with full automation, visual snapshots, QR code recognition, and deliverable/handoff lifecycle management.",
  "author": {
    "name": "Cypheria"
  },
  "keywords": [
    "browser",
    "automation",
    "web",
    "cdp",
    "in-app browser",
    "node-repl",
    "browser-client"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Browser",
    "shortDescription": "Control the in-app browser",
    "longDescription": "Lets the Agent open, navigate, inspect, interact with, and screenshot web pages and local apps inside Cypheria's built-in browser via node-repl.",
    "developerName": "Cypheria",
    "category": "Automation",
    "capabilities": ["Interactive", "Read", "Write"],
    "defaultPrompt": "Open localhost:3000 and inspect the page.",
    "composerIcon": "./assets/composer-icon.png",
    "logo": "./assets/browser.png"
  }
}
