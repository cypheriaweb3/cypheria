{
  "mcpServers": {
    "browser": {
      "command": "node",
      "args": ["./mcp/server.mjs", "--server", "browser"],
      "cwd": ".",
      "omit_tools_from": ["deferred"],
      "default_tools_approval_mode": "approve",
      "env_vars": ["CYPHERIA_SERVER_URL", "CYPHERIA_APP_TOOLS_TOKEN"],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600
    }
  }
}
