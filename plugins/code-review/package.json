{
  "name": "@cypheria/code-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The bundled code-review plugin: its manifests, MCP relay, and the Code Review MCP App served as ui://pull-requests/app.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm i18n:compile && pnpm typecheck",
    "dev": "vite build --watch",
    "i18n:compile": "lingui compile --strict",
    "i18n:extract": "lingui extract --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cypheria/protocol": "workspace:*",
    "@cypheria/ui": "workspace:*",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@pierre/diffs": "^1.4.3",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-query": "^5.100.14",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "streamdown": "^2.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.7"
  }
}
