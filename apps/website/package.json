{
  "name": "@cypheria/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm i18n:compile && vite build && node scripts/verify-build.mjs",
    "cf-typegen": "wrangler types",
    "check": "pnpm i18n:compile && pnpm typecheck && vitest run",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "dev": "vite dev",
    "i18n:compile": "lingui compile --strict",
    "i18n:extract": "lingui extract --clean",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cypheria/ui": "workspace:*",
    "@fumadocs/language": "^0.2.5",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-start": "^1.168.14",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.12",
    "lucide-react": "^1.47.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@playwright/test": "^1.55.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.135.0"
  }
}
