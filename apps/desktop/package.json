{
  "name": "@cypheria/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && pnpm build:dapp-preload && pnpm build:renderer && pnpm typecheck",
    "build:dapp-preload": "tsdown --config tsdown.dapp-preload.config.mjs",
    "build:main": "tsdown --config tsdown.config.mjs && node scripts/copy-db-migrations.mjs",
    "build:preload": "tsdown --config tsdown.preload.config.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "check": "pnpm i18n:compile && pnpm typecheck",
    "dev": "pnpm build:main && pnpm build:preload && pnpm build:renderer && pnpm rebuild:native && electron .",
    "dev:renderer": "vite dev --config vite.config.ts --host 127.0.0.1",
    "i18n:compile": "lingui compile --strict",
    "i18n:extract": "lingui extract --clean",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "test": "vitest run",
    "test:electron-wallet-provider": "pnpm build:dapp-preload && electron test/electron-wallet-provider-smoke.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/react": "^4.0.90",
    "@cypheria/automation-core": "workspace:*",
    "@cypheria/codex-bridge": "workspace:*",
    "@cypheria/db": "workspace:*",
    "@cypheria/network-core": "workspace:*",
    "@cypheria/policy-engine": "workspace:*",
    "@cypheria/runtime": "workspace:*",
    "@cypheria/ui": "workspace:*",
    "@cypheria/wallet-core": "workspace:*",
    "@cypheria/wallet-provider": "workspace:*",
    "@hello-pangea/dnd": "^18.0.1",
    "@libsql/client": "^0.17.4",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@openai/codex": "0.151.0",
    "@solana/wallet-standard-chains": "^1.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-start": "^1.168.14",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.87",
    "jotai": "^2.20.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@electron/rebuild": "^4.2.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
