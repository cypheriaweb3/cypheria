{
  "name": "@cypheria/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cypheria-server": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs && node scripts/embed-web.mjs",
    "check": "pnpm typecheck",
    "server": "node dist/cli.mjs",
    "dev": "tsx watch src/dev.ts",
    "start": "node dist/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@cypheria/db": "workspace:*",
    "@cypheria/protocol": "workspace:*",
    "@cypheria/relay": "workspace:*",
    "@cypheria/web3": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.17.4",
    "@opencode/client": "2.0.11",
    "@scure/bip39": "^1.6.0",
    "@zip.js/zip.js": "2.16.0",
    "ethers": "^6.17.0",
    "extract-zip": "^2.0.1",
    "hono": "^4.13.7",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.10",
    "tar": "^7.5.11",
    "unbzip2-stream": "1.4.3",
    "viem": "^2.56.1",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cypheria/client": "workspace:*",
    "@cypheria/expo": "workspace:*",
    "@types/unbzip2-stream": "1.4.3",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "vitest": "^4.1.7"
  }
}
