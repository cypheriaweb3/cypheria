{
  "name": "@cypheria/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cypheria/automation-core": "workspace:*",
    "@cypheria/network-core": "workspace:*",
    "@cypheria/policy-engine": "workspace:*",
    "@cypheria/wallet-core": "workspace:*",
    "@cypheria/wallet-provider": "workspace:*",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.7"
  }
}
